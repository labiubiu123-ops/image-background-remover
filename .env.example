REMOVEBG_API_KEY=your-removebg-api-key
NEXT_PUBLIC_REMOVEBG_API_KEY=your-removebg-api-key

# Google OAuth — 从 https://console.cloud.google.com 获取
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth secret — 运行 `openssl rand -base64 32` 生成
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://your-domain.com

# Cloudflare D1 通过 wrangler.toml binding 注入，不需要在 .env 配置
# 本地开发无数据库时自动降级为 JWT session
